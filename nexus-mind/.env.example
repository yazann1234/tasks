# ─────────────────────────────────────────────────────────────
# NEXUS Mind — environment template
# Copy to `.env` for local development only. NEVER commit `.env`.
#
# In the packaged app, API keys are entered in Settings → AI and
# encrypted at rest with the OS keychain (Electron safeStorage).
# Values here are only read by the main process as a dev fallback;
# they are never exposed to the renderer.
# ─────────────────────────────────────────────────────────────

# AI providers (any one is enough; Ollama needs no key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional cloud sync (Supabase). Data is E2E-encrypted before upload.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional Google Calendar sync (OAuth desktop client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev only: seed demo data on first launch (true/false)
NEXUS_SEED_DEMO=true

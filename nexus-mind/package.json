{
  "name": "nexus-mind",
  "productName": "NEXUS Mind",
  "version": "0.1.0",
  "description": "AI-powered personal productivity operating system",
  "main": "./out/main/index.js",
  "author": "NEXUS Mind",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "11.6.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/jetbrains-mono": "5.1.1",
    "@fontsource/tajawal": "5.1.0",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.4",
    "@tanstack/react-query": "5.61.0",
    "@testing-library/react": "16.0.1",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.9.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "cal-sans": "1.0.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "framer-motion": "11.11.17",
    "i18next": "23.16.8",
    "jsdom": "25.0.1",
    "lucide-react": "0.460.0",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.1",
    "tailwind-merge": "2.5.4",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5",
    "zod": "3.23.8",
    "zustand": "5.0.1"
  }
}
